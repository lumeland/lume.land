---
layout: ./base.vto
page_css: docs.css
---

<div class="doc">
  {{ include "templates/plugin-navbar.vto" }}

  <main class="doc-content">
    <header class="doc-header">
      <h1>
        {{ title }}
        {{ if it.enabled }}
          <span class="tag is-small">Installed</span>
        {{ /if }}
      </h1>
      {{ description |> md }}

      <nav class="toc" toc="content"></nav>
    </header>

    <div class="doc-body" id="content">
      {{ if it.mod }}
        <h2>Options</h2>

        {{ include "templates/type.vto" { options: await scheme(mod) } }}
      {{ /if }}

      {{ content }}
    </div>
  </main>
</div>
